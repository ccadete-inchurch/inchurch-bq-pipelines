# API Tokens
INCHURCH_TOKEN=your-inchurch-token-here
A6_TOKEN=your-a6-token-here

# Superlogica API Configuration
SUPERLOGICA_APP_TOKEN=your-superlogica-app-token-here
SUPERLOGICA_API_URL=https://api.superlogica.net/v2/financeiro/

# Database Connection
DB_CONNECTION_STRING=postgresql+pg8000://USER:PASSWORD@/DB_NAME?unix_sock=/cloudsql/PROJECT:REGION:INSTANCE/.s.PGSQL.5432

# Notification Webhook
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url/api/v1/chats/space/
NOTIFICATION_SPACE_ID=your-space-id

# API Request Parameters (optional, has defaults)
API_TIMEOUT=180
API_CHUNK_SIZE=5000
API_RATE_LIMIT_SLEEP=0.2
API_MAX_RETRIES=3

# Database Parameters (optional, has defaults)
DB_BATCH_SIZE=5000

# Thread Pool Configuration (optional, has defaults)
THREAD_POOL_MAX_WORKERS=3
